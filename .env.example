# Local development with XAMPP MariaDB:
DATABASE_URL="mysql://root:@localhost:3306/kaizen"

# Production on Aiven (copy the Service URI from the Aiven console, then replace everything after "?" with sslaccept):
# DATABASE_URL="mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslaccept=accept_invalid_certs"
# Optional, makes the app verify Aiven's certificate: paste the CA certificate (Aiven console, Connection information).
# In Render, paste it as is (multi-line). In a .env file, write it on one line with \n between lines.
# DATABASE_CA=""

AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_TRUST_HOST=true

# Sent as the x-cron-secret header by the daily job (/api/internal/rollover)
CRON_SECRET="generate with: openssl rand -hex 16"
